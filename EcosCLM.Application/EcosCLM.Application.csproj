<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Ativa a análise de código nativa do .NET (Roslyn Analyzers) em todos os projetos -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<!-- Define o nível de análise como o mais rígido e moderno disponível -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<!-- Trata os avisos de qualidade (Warnings) como erros, quebrando a build do CI se o código estiver fora do padrão -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="AutoMapper" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\EcosCLM.Domain\EcosCLM.Domain.csproj" />
	</ItemGroup>
</Project>