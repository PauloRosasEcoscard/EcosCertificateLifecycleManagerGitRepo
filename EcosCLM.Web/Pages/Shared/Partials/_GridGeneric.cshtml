@model EcosCLM.Web.Models.GridConfiguration

<div class="ecos-card">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold mb-0">@Model.Title</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(Model.AddPageUrl))
            {
                <a asp-page="@Model.AddPageUrl" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                    <i class="material-symbols-outlined fs-6">add</i> New Record
                </a>
            }
        </div>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group input-group-sm max-width-300">
            <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="material-symbols-outlined fs-6">search</i>
            </span>
            <input type="text" name="Search.TxName" value="@Model.SearchQuery" class="form-control border-start-0 ps-0 shadow-none" placeholder="@Model.SearchPlaceholder" />
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <a asp-page="./Index" class="btn btn-outline-secondary d-flex align-items-center justify-content-center">
                    <i class="material-symbols-outlined fs-6">close</i>
                </a>
            }
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-borderless align-middle mb-0">
            <thead>
                <tr class="text-muted">
                    @foreach (var header in Model.Headers)
                    {
                        <th class="text-center">@header</th>
                    }
                    <th class="text-end" style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top border-color opacity-75">
            <div class="small text-muted">
                Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded d-flex align-items-center justify-content-center" href="./Index?p=@(Model.CurrentPage - 1)&Search.TxName=@Model.SearchQuery" aria-label="Previous">
                            <i class="material-symbols-outlined fs-6">chevron_left</i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded" href="./Index?p=@i&Search.TxName=@Model.SearchQuery">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded d-flex align-items-center justify-content-center" href="./Index?p=@(Model.CurrentPage + 1)&Search.TxName=@Model.SearchQuery" aria-label="Next">
                            <i class="material-symbols-outlined fs-6">chevron_right</i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>