@using System.Reflection
@using EcosCLM.Web.EcosLoginIntegration.Model
@using EcosCLM.Web.EcosLoginIntegration.Services
@using Newtonsoft.Json
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject EcosCLM.Web.EcosLoginIntegration.Interfaces.IEncryptionService _encryptionService

@{
    bool IsAdmin = false;
    bool IsAudit = false;

    var profileClaim = User.Claims.FirstOrDefault(c => c.Type == "Profile");

    if (profileClaim != null && int.TryParse(profileClaim.Value, out int profileInt))
    {
        TypeProfile profile = ((TypeProfile)profileInt);

        switch (profile)
        {
            case TypeProfile.Admin:
                IsAdmin = true;
                break;

            case TypeProfile.Audit:
                IsAudit = true;
                break;
        }
    }

    List<ContextRolesViewModel> ContextRoles = new List<ContextRolesViewModel>();
    try
    {
        var claimsRoles = User.FindFirst(ClaimTypes.Role)?.Value;
        if (!string.IsNullOrEmpty(claimsRoles))
        {
            var encryptKey = Configuration["EncryptKey"] ?? "ChavePadraoEcosIfEmpty";

            var decryptedJson = _encryptionService.Decrypt(claimsRoles, encryptKey);
            ContextRoles = JsonConvert.DeserializeObject<List<ContextRolesViewModel>>(decryptedJson) ?? new List<ContextRolesViewModel>();
        }
    }
    catch
    {
        ContextRoles = new List<ContextRolesViewModel>();
    }
}

@functions
{
    bool IsActivePage(string pageName)
    {
        var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
        var currentPath = ViewContext.HttpContext.Request.Path.Value?.ToLower() ?? string.Empty;

        return currentPage.Equals(pageName, StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith(pageName.ToLower());
    }

    bool ShowPage(List<ContextRolesViewModel> contextRoles, string txPage)
    {
        try
        {
            return contextRoles.Any(x => txPage.Contains(x.ModuleController, StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            return false;
        }
    }
}

