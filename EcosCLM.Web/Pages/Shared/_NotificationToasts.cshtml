@{
    string? tempError = TempData["error"] as string;
    string? tempWarning = TempData["warning"] as string;
    string? tempInfo = TempData["info"] as string;
    string? tempSuccess = TempData["success"] as string;
    string? modal = TempData["modal"] as string;

    var toastTypes = new[]
    {
        new { Data = tempError, ColorClass = "text-danger", BorderColor = "var(--bs-danger)", Icon = "error", Title = "Error" },
        new { Data = tempWarning, ColorClass = "text-warning", BorderColor = "var(--bs-warning)", Icon = "warning", Title = "Warning" },
        new { Data = tempInfo, ColorClass = "text-info", BorderColor = "var(--bs-info)", Icon = "info", Title = "Information" },
        new { Data = tempSuccess, ColorClass = "text-success", BorderColor = "var(--bs-success)", Icon = "check_circle", Title = "Success" }
    };

    bool hasActiveToasts = !string.IsNullOrEmpty(tempError) || !string.IsNullOrEmpty(tempWarning) ||
                           !string.IsNullOrEmpty(tempInfo) || !string.IsNullOrEmpty(tempSuccess);
}

@* 1. Backdrop/Overlay com transparência exata de 50% e fechamento no clique *@
@if (hasActiveToasts)
{
    <div id="toast-backdrop" class="position-fixed top-0 start-0 w-100 h-100 bg-black bg-opacity-50 transition-all"
         style="z-index: 1111110; backdrop-filter: blur(4px); cursor: pointer;" onclick="dismissAllActiveToasts()"></div>
}

@* 2. Container centralizado na tela *@
<div id="toast-wrapper" class="position-fixed top-50 start-50 translate-middle d-flex flex-column align-items-center justify-content-center w-100 p-4" style="z-index: 1111111; max-width: 500px; pointer-events: none;">
    @foreach (var type in toastTypes)
    {
        if (!string.IsNullOrEmpty(type.Data))
        {
            var messages = type.Data.Split(new[] { '|' }, StringSplitOptions.RemoveEmptyEntries);
            for (int i = 0; i < messages.Length; i++)
            {
                <div class="toast show border-0 rounded-4 shadow-lg w-100 overflow-hidden mb-3 p-2"
                     role="alert" aria-live="assertive" aria-atomic="true" id="toast-@type.Title-@i"
                     style="background: var(--bs-body-bg); border-top: 5px solid @type.BorderColor !important; pointer-events: auto; animation: toastAnimateIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;">

                    <div class="p-4 text-center">
                        <div class="mb-3">
                            <i class="material-symbols-outlined @type.ColorClass" style="font-size: 3.5rem;">@type.Icon</i>
                        </div>

                        <h5 class="fw-bold text-main mb-2" style="color: var(--bs-body-color);">@type.Title</h5>

                        <p class="text-muted small mb-4 lh-base text-wrap px-2">
                            @messages[i]
                        </p>

                        <div class="d-grid">
                            <button type="button" class="btn btn-ecos-action py-2.5 rounded-3 fw-semibold small"
                                    data-bs-dismiss="toast" onclick="dismissAllActiveToasts()">
                                Ok, entendi
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@* Renderização do Modal de Atenção tradicional *@
@if (!string.IsNullOrEmpty(modal))
{
    <div class="modal fade" id="popupModal" tabindex="-1" aria-labelledby="popupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--bs-body-bg);">
                <div class="modal-header border-bottom p-4 border-color-subtle">
                    <div class="d-flex align-items-center gap-2">
                        <i class="material-symbols-outlined text-warning fs-3">warning</i>
                        <h5 class="modal-title fw-bold text-main mb-0" id="popupModalLabel" style="color: var(--bs-body-color);">Attention!</h5>
                    </div>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-muted small lh-base">
                    @Html.Raw(modal)
                </div>
                <div class="modal-footer border-top p-4 bg-light bg-opacity-10 border-color-subtle d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-soft-danger px-4 fw-semibold small" data-bs-dismiss="modal" style="min-width: 100px;">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes toastAnimateIn {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(20px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .btn-ecos-action {
        background-color: var(--bs-primary);
        color: #fff;
        border: none;
        transition: opacity 0.2s ease;
    }

        .btn-ecos-action:hover {
            opacity: 0.9;
            color: #fff;
        }
</style>

<script>
    function dismissAllActiveToasts() {
        // Remove o overlay com fade-out sutil
        const backdrop = document.getElementById('toast-backdrop');
        if (backdrop) {
            backdrop.style.opacity = '0';
            setTimeout(() => backdrop.remove(), 200);
        }

        // Esconde todos os Toasts visíveis na tela usando a API nativa do Bootstrap 5
        const activeToasts = document.querySelectorAll('#toast-wrapper .toast.show');
        activeToasts.forEach(element => {
            const toastInstance = bootstrap.Toast.getInstance(element);
            if (toastInstance) {
                toastInstance.hide();
            } else {
                element.classList.remove('show');
            }
        });
    }

    window.addEventListener('load', function () {
        var modalElement = document.getElementById('popupModal');
        if (modalElement) {
            var popupModal = new bootstrap.Modal(modalElement);
            popupModal.show();
        }
    });
</script>