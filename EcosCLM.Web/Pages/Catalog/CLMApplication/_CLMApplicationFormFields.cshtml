@model EcosCLM.Application.ViewModels.Catalog.CLMApplicationViewModel

<div class="row g-4 px-2 pb-2">

    <div class="col-12">
        <h6 class="fw-bold mb-0 pb-2 border-bottom border-2" style="border-color: var(--bs-primary) !important; color: var(--bs-primary);">
            Application Specifications
        </h6>
    </div>

    <div class="col-md-6">
        <label asp-for="Code" class="form-label small fw-bold text-muted mb-1">Application Code</label>
        <input asp-for="Code" class="form-control ecos-input shadow-none rounded-3 px-3 py-2" placeholder="Ex: APP-PAYMENTS, APP-AUTH" required />
        <span asp-validation-for="Code" class="text-danger small mt-1"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label small fw-bold text-muted mb-1">Application Name</label>
        <input asp-for="Name" class="form-control ecos-input shadow-none rounded-3 px-3 py-2" placeholder="Ex: Payment Gateway Service" required />
        <span asp-validation-for="Name" class="text-danger small mt-1"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Criticality" class="form-label small fw-bold text-muted mb-1">Criticality Level</label>
        <select asp-for="Criticality" class="form-select ecos-input shadow-none rounded-3 px-3 py-2">
            <option value="LOW">Low</option>
            <option value="MEDIUM">Medium</option>
            <option value="HIGH">High</option>
            <option value="CRITICAL">Critical</option>
        </select>
        <span asp-validation-for="Criticality" class="text-danger small mt-1"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Status" class="form-label small fw-bold text-muted mb-1">Status</label>
        <select asp-for="Status" class="form-select ecos-input shadow-none rounded-3 px-3 py-2">
            <option value="ACTIVE">Active</option>
            <option value="INACTIVE">Inactive</option>
            <option value="DEPRECATED">Deprecated</option>
        </select>
        <span asp-validation-for="Status" class="text-danger small mt-1"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label small fw-bold text-muted mb-1">Description</label>
        <textarea asp-for="Description" class="form-control ecos-input shadow-none rounded-3 px-3 py-2" rows="3" placeholder="Describe the purpose or scope of this application..."></textarea>
        <span asp-validation-for="Description" class="text-danger small mt-1"></span>
    </div>

</div>
