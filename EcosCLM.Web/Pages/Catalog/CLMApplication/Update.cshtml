@page "{id:Guid}"
@model EcosCLM.Web.Pages.Catalog.CLMApplication.UpdateModel
@{
    ViewData["Title"] = "Edit Application";
}

<div class="row">
    <div class="col-12 mt-3">
        <ecos-form title="Edit Application"
                   subtitle="Modify application parameters or status.">

            <input type="hidden" asp-for="Item.Id" />
            <input type="hidden" asp-for="Item.CreatedAt" />

            <partial name="_CLMApplicationFormFields" for="Item" />

        </ecos-form>
    </div>
</div>
