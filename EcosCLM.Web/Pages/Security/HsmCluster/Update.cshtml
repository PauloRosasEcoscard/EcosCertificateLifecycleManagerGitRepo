@page "{id:Guid}"
@model EcosCLM.Web.Pages.Security.HsmCluster.UpdateModel
@{
    ViewData["Title"] = "Edit HSM Cluster";
}

<div class="row">
    <div class="col-12 mt-3">
        <ecos-form title="Edit HSM Cluster"
                   subtitle="Modify cluster endpoints, partition parameters, or status.">

            <input type="hidden" asp-for="Item.Id" />
            <input type="hidden" asp-for="Item.CreatedAt" />

            <partial name="_HsmClusterFormFields" for="Item" />

        </ecos-form>
    </div>
</div>
