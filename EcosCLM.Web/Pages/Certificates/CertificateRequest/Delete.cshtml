@page "{id:Guid}"
@model EcosCLM.Web.Pages.Certificates.CertificateRequest.DeleteModel
@{
    ViewData["Title"] = "Delete Certificate Request";
    ViewData["Breadcrumb"] = "Certificates";
    ViewData["PageName"] = "Requests";
}

<div class="row">
    <div class="col-12">
        <div class="card my-4">

            <div class="card-header p-0 position-relative">
                <div class="card-body d-flex align-items-center justify-content-between bg-secondary pt-4 pb-3">
                    <h5 class="text-white text-capitalize fw-bold fs-5 mb-0">Delete Certificate Request</h5>
                </div>
            </div>

            <div class="card-body px-4 pb-4">

                <form method="post">
                    <input type="hidden" asp-for="Item.Id" />

                    <p>Are you sure you want to delete the certificate request <strong>@Model.Item.SubjectDn</strong>?</p>
                    <p class="fw-bold text-danger">This action will delete all linked records and is <u>irreversible</u>.</p>

                    <div class="col-md-12 text-center mt-4">
                        <div class="row">
                            <div class="col-md-6">
                                <a asp-page="Index" class="btn btn-secondary w-100">Cancel</a>
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn-danger btn w-100">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>