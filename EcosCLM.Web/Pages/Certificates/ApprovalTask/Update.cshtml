        <ecos-form title="Edit Approval Task"
                   subtitle="Modify workflow step decision, approvers or status.">

            <input type="hidden" asp-for="Item.Id" />
            <input type="hidden" asp-for="Item.CreatedAt" />

            <partial name="_ApprovalTaskFormFields" for="Item" />

        </ecos-form>
    </div>
</div>