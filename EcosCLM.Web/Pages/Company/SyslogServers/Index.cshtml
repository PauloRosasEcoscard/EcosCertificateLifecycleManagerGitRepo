@page
@model Ecos_Cloud_Vhsm_Dashboard.Pages.Company.SyslogServers.IndexModel
@{
    ViewData["Title"] = "Company";
    ViewData["Breadcrumb"] = "Ecos Cloud Vhsm";
    ViewData["PageName"] = "Syslog Servers";
}

<div class="modal fade" id="SyslogServerModal" tabindex="-1" role="dialog" aria-labelledby="SyslogServerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form method="post" asp-page-handler="Save" class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold" id="SyslogServerModalLabel">Configure Syslog Server</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-check form-switch ms-3 mb-3">
                    <input class="form-check-input mt-2" asp-for="Item.UseTls" type="checkbox" id="UseTLS">
                    <label class="form-check-label mt-1" asp-for="Item.UseTls">Use TLS</label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Verification CA</label>
                    <textarea class="rounded border form-control px-3" id="VerificationCA" asp-for="Item.VerificationCA"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Server Address</label>
                    <input class="rounded border form-control px-3" id="ServerAddress" asp-for="Item.ServerAddress" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Port</label>
                    <input class="rounded border form-control px-3" id="Port" asp-for="Item.Port" value="514" />
                </div>

                <div class="form-check form-switch ms-3 mb-3">
                    <input class="form-check-input mt-2" asp-for="Item.SyslogServerEnabled" type="checkbox" id="SyslogServerEnabled">
                    <label class="form-check-label mt-1" asp-for="Item.SyslogServerEnabled">Syslog Server Enabled</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-12 mt-3">

        <ecos-grid config="Model.GridConfig">

            <search-append>
                <div class="max-width-300">
                    <input type="text" name="Search.ServerAddress" value="@Model.Search?.ServerAddress" class="form-control form-control-sm border border-color-subtle bg-transparent text-main shadow-none" placeholder="Server Address...">
                </div>
            </search-append>

            @if (Model.Itens?.Any() == true)
            {
                @foreach (var item in Model.Itens)
                {
                    <div class="ecos-model-card p-3">
                        <div class="row align-items-center w-100 m-0">

                            <div class="col-12 col-md-3 mb-2 mb-md-0">
                                <span class="ecos-card-label">Server Address</span>
                                <span class="ecos-card-value fw-semibold text-main d-block">@item.ServerAddress</span>
                            </div>

                            <div class="col-12 col-md-2 mb-2 mb-md-0">
                                <span class="ecos-card-label">Port</span>
                                <span class="ecos-card-value text-main d-block">@item.Port</span>
                            </div>

                            <div class="col-12 col-md-3 mb-2 mb-md-0">
                                <span class="ecos-card-label">Syslog Status</span>
                                <span class="badge @(item.SyslogServerEnabled ? "bg-success text-success" : "bg-secondary text-secondary") bg-opacity-10 rounded-pill px-2.5 py-1">
                                    @(item.SyslogServerEnabled ? "Enabled" : "Disabled")
                                </span>
                            </div>

                            <div class="col-12 col-md-2 mb-2 mb-md-0">
                                <span class="ecos-card-label">Use TLS</span>
                                <span class="ecos-card-value text-muted d-block">@(item.UseTls ? "Yes" : "No")</span>
                            </div>

                            <div class="col-12 col-md-2 text-end ms-auto card-action-col">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-page="Update" asp-route-id="@item.Id" class="btn btn-link text-primary p-1 d-inline-flex align-items-center" title="Editar">
                                        <i class="material-symbols-outlined fs-5">edit</i>
                                    </a>
                                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-link text-danger p-1 d-inline-flex align-items-center" title="Excluir">
                                        <i class="material-symbols-outlined fs-5">delete</i>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="ecos-model-card p-4 text-center text-muted small">
                    Sem informações disponíveis.
                </div>
            }

        </ecos-grid>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const useTlsCheckbox = document.getElementById("UseTLS");
            const verificationCAField = document.getElementById("VerificationCA").closest(".mb-3");

            function toggleVerificationCA() {
                if (useTlsCheckbox && verificationCAField) {
                    if (useTlsCheckbox.checked) {
                        verificationCAField.style.display = "block";
                    } else {
                        verificationCAField.style.display = "none";
                    }
                }
            }

            toggleVerificationCA();

            if (useTlsCheckbox) {
                useTlsCheckbox.addEventListener("change", toggleVerificationCA);
            }
        });
    </script>
}