{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel.Tokens": "Debug"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.IdentityModel.Tokens": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/applog-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "EcosCloudVhsm Dashboard"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EcosCLM": "Data Source=.\\SQLEXPRESS;Initial Catalog=EcosCLM;Integrated Security=True;TrustServerCertificate=True;"
  },
  "RepositoryType": "SQL", // USE "SQL" or "MYSQL"
  "AppSettings": {
    "DaysExpirated": 1,
    "Secret": "F11ABBD6-80C8-4A9E-8043-51DC2E7B6EC1",
    "Clients": {
      "Dashboard": "http://localhost:5298",
      "Login": "http://localhost:5050"
    }
  }
}
